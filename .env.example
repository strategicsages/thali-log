# Passcode you type on the login screen
APP_PASSCODE=
# Long random string used to sign the login cookie (openssl rand -hex 32)
SESSION_SECRET=
# From console.anthropic.com
ANTHROPIC_API_KEY=
# Optional model overrides
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_QUICK=claude-haiku-5-5
# Added automatically when you connect a Vercel Blob store to the project
BLOB_READ_WRITE_TOKEN=
