# Passcode you type on the login screen
APP_PASSCODE=
# Long random string used to sign the login cookie (openssl rand -hex 32)
SESSION_SECRET=
# Which AI provider answers: gemini (free key from aistudio.google.com), groq (free key from console.groq.com), openrouter, anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Optional model overrides
LLM_MODEL=
LLM_MODEL_QUICK=
# Added automatically when you connect a Vercel Blob store to the project
BLOB_READ_WRITE_TOKEN=
